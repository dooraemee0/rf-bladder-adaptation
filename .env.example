# Copy this file to .env, replace every path, and run `source .env`.
# The `export` keyword is intentional so the shell wrappers can read the values.

export DATA_ROOT=/absolute/path/to/bladder-data
export CLINICAL_CKPT=/absolute/path/to/rf-bladder/checkpoints/best_model.pt
export TEST_IDX_PATH=/absolute/path/to/rf-bladder/checkpoints/test_idx.pt
